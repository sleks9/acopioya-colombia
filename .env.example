# Copia este archivo como .env.local y rellena los valores.
# En Vercel, estas mismas variables van en Settings -> Environment Variables.

# URL y llave publicable del proyecto Supabase.
# La llave publicable es publica por diseño: toda la seguridad vive en Postgres
# (RLS + funciones security definer). NUNCA pongas aqui la service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Sal para anonimizar las IP antes de guardarlas. Sirve para limitar abuso por
# conexion sin conservar un dato personal identificable.
# Genera una propia con: openssl rand -hex 32
IP_SALT=cambia-esto-por-una-cadena-larga-y-aleatoria

# URL publica del sitio. Se usa en las etiquetas Open Graph (la vista previa
# al compartir por WhatsApp) y en los enlaces absolutos.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
